{
  "commands": [
    {
      "name": "install-payments",
      "run": "cd miniapps/payments && npm ci",
      "remote": true
    },
    {
      "name": "install-transfers",
      "run": "cd miniapps/transfers && npm ci",
      "remote": true
    },
    {
      "name": "lint-payments",
      "run": "cd miniapps/payments && npm run lint",
      "role": "gate",
      "timeout": 60,
      "limit": 3,
      "remote": true
    },
    {
      "name": "lint-transfers",
      "run": "cd miniapps/transfers && npm run lint",
      "role": "gate",
      "timeout": 60,
      "limit": 3,
      "remote": true
    },
    {
      "name": "scan-payments-trivy",
      "run": "cd miniapps/payments && trivy fs --severity HIGH,CRITICAL --exit-code 1 --no-progress .",
      "role": "gate",
      "timeout": 180,
      "limit": 3,
      "remote": true
    },
    {
      "name": "scan-transfers-trivy",
      "run": "cd miniapps/transfers && trivy fs --severity HIGH,CRITICAL --exit-code 1 --no-progress .",
      "role": "gate",
      "timeout": 180,
      "limit": 3,
      "remote": true
    },
    {
      "name": "test-payments",
      "run": "cd miniapps/payments && npx jest --ci",
      "role": "gate",
      "timeout": 120,
      "limit": 3,
      "remote": true
    },
    {
      "name": "test-transfers",
      "run": "cd miniapps/transfers && npx jest --ci",
      "role": "gate",
      "timeout": 120,
      "limit": 3,
      "remote": true
    },
    {
      "name": "bundle-payments",
      "run": "cd miniapps/payments && mkdir -p dist/ios/assets && npm run bundle:ios",
      "role": "gate",
      "timeout": 300,
      "limit": 3,
      "remote": true
    },
    {
      "name": "bundle-transfers",
      "run": "cd miniapps/transfers && mkdir -p dist/ios/assets && npm run bundle:ios",
      "role": "gate",
      "timeout": 300,
      "limit": 3,
      "remote": true
    }
  ],
  "vcs": {
    "org": "AwesomeCICD",
    "repo": "circleci-mobile-banking-app"
  },
  "validation": {
    "sidecarImage": "55034c6c-0d19-4da4-a892-c4500dd8aaa0"
  },
  "orgID": "0ffedcab-0755-4ea2-a76e-7f8a0b082494",
  "environment": {
    "stack": "ruby",
    "setup": [
      {
        "name": "install",
        "command": "bundle install"
      },
      {
        "name": "test",
        "command": "bundle exec rspec"
      }
    ],
    "image": "cimg/ruby",
    "image_version": "4.0.2"
  }
}
