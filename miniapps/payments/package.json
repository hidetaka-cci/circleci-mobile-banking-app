{
  "name": "payments-miniapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output dist/ios/main.jsbundle --assets-dest dist/ios/assets",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output dist/android/index.android.bundle --assets-dest dist/android/res",
    "lint": "eslint src/ __tests__/",
    "test": "jest"
  },
  "dependencies": {
    "@react-native/metro-config": "0.73.5",
    "react": "18.2.0",
    "react-native": "0.73.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "jest": "^29.6.3",
    "jest-junit": "^16.0.0",
    "react-test-renderer": "18.2.0"
  },
  "jest": {
    "preset": "./node_modules/react-native/jest-preset.js",
    "reporters": [
      "default",
      "jest-junit"
    ]
  },
  "jest-junit": {
    "outputDirectory": "test-reports",
    "outputName": "junit.xml",
    "addFileAttribute": "true"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "shell-quote": "1.8.4",
    "fast-xml-parser": "5.8.0",
    "ws@6": "6.2.4",
    "ws@7": "7.5.11"
  }
}
